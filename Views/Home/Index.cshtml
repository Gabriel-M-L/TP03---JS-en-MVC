    <p class="mostrarPalabra" id="mostrarPalabra">
        @foreach(char letra in ViewBag.palabra){
            @Html.Raw("_");
        }
    </p>
    Letras usadas: <input type="text" value=" " id = "letrasUsadas"readonly> <br>
    Intentos restantes: <div id="cantIntentos">10</div>
